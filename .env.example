# Environment variable overrides for discretus.
#
# Copy this file to .env and edit the values you need. Nothing in the
# library reads .env automatically, because the core has no third party
# dependencies and therefore no dotenv loader. Use the file in one of the
# following ways instead.
#
# Export the variables into the current shell:
#
#   set -a; . ./.env; set +a
#
# Pass the file to a container:
#
#   docker run --env-file .env discretus:latest
#
# Or reference it from a compose service:
#
#   services:
#     tests:
#       env_file: .env
#
# Every variable corresponds to one field of discretus.config.Config. The
# name is the field name in upper case with the DISCRETUS_ prefix, and the
# value is read at import time by config_from_environment. Anything not set
# keeps the library default shown after the equals sign below. A value that
# cannot be read as its field type raises ValidationError on import, which
# is deliberate: a silently ignored misspelling would be worse than a loud
# failure at startup.
#
# The .env file is listed in .gitignore. Never commit it, and never put a
# credential in it, because this library needs none.

# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

# Whether routines verify preconditions even when the check costs as much as
# the computation it guards. Leave it enabled while developing, and consider
# disabling it in a hot loop whose inputs are already known to be valid.
# Accepted values: 1, true, yes, on, 0, false, no, off.
DISCRETUS_STRICT_VALIDATION=true

# ---------------------------------------------------------------------------
# Guard rails against combinatorial explosion
# ---------------------------------------------------------------------------

# Upper bound on the number of objects a routine will materialize before
# raising LimitExceededError. The guard protects against accidentally
# building an astronomically large structure, for instance the power set of
# a ground set with sixty members, which has more subsets than there are
# atoms in a grain of sand. Lazy generators are never affected by this
# limit, so an iteration over the same space remains possible.
DISCRETUS_MAX_ENUMERATION=1000000

# Depth at which the recursive reference implementations hand over to their
# iterative variants. The default sits below the interpreter recursion limit
# so that a deep traversal reports a library error rather than a
# RecursionError from the interpreter.
DISCRETUS_MAX_RECURSION_DEPTH=900

# ---------------------------------------------------------------------------
# Transparency
# ---------------------------------------------------------------------------

# Whether routines that support step recording collect their derivation by
# default. Enabling it globally is convenient in a teaching notebook, where
# every computation should be able to explain itself, and wasteful in a
# production pipeline, where the steps are discarded unread.
DISCRETUS_EXPLAIN=false

# ---------------------------------------------------------------------------
# Rendering
# ---------------------------------------------------------------------------

# How the LaTeX mixin wraps its output. The inline style produces a fragment
# suitable for embedding in a sentence, and the display style produces a
# centred equation.
# Accepted values: inline, display.
DISCRETUS_LATEX_STYLE=inline

# How formulas and set expressions are printed. The ascii notation uses the
# operators the parser accepts, which makes printed output re readable by
# the library. The unicode notation uses the conventional mathematical
# symbols, which reads better in a terminal and in slides.
# Accepted values: ascii, unicode.
DISCRETUS_NOTATION=ascii

# Preferred visualization backend. The value auto selects the first backend
# whose dependencies are installed, in the order graphviz, matplotlib, svg,
# ascii, so that a machine without an optional stack still renders
# something useful.
# Accepted values: auto, ascii, svg, graphviz, matplotlib.
DISCRETUS_VIZ_BACKEND=auto

# ---------------------------------------------------------------------------
# Reproducibility
# ---------------------------------------------------------------------------

# Seed used by randomized routines when the caller supplies none. Leaving it
# unset keeps those routines nondeterministic, which is the right default
# for a library. Setting it makes an entire process reproducible, which is
# what a benchmark run, a graded exercise, or a failing test case needs.
# Accepted values: a non negative integer, or none.
DISCRETUS_DEFAULT_SEED=none

# Absolute tolerance for the few comparisons that cannot be made exactly
# because a floating point value entered the computation. Exact routines
# ignore it entirely. Lowering it makes those comparisons stricter, and
# raising it makes them more forgiving.
DISCRETUS_TOLERANCE=1e-12
